# Local development placeholders. Copy to backend/.env and export, or set in your shell.
# Never commit real credentials.

SPRING_PROFILES_ACTIVE=local

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portfolio
SPRING_DATASOURCE_USERNAME=portfolio
SPRING_DATASOURCE_PASSWORD=portfolio

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Used later to hash client IPs for contact abuse correlation. Do not reuse across environments.
APP_IP_HASH_PEPPER=replace-with-a-long-random-string

# Optional. Public GitHub data works without a token; a token raises rate limits in Phase 5.
GITHUB_TOKEN=
GITHUB_USERNAME=

# Local only. Keep disabled in production (application-prod.yml already disables Springdoc).
SPRINGDOC_ENABLED=true
